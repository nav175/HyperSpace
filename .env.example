# Copy to .env.local and fill in:  cp .env.example .env.local
# .env.local is gitignored. Share it with the team privately, never through the repo.

# TiDB Cloud Starter, AWS Oregon (us-west-2): cluster page → Connect → Generate Password.
# Search embeddings come from TiDB's free built-in model, so they need no extra key.
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=hyperspace

# Gemini, used by Grow (Expand), Connect and Ask: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: ElevenLabs, for the Listen buttons (https://elevenlabs.io/app/settings/api-keys).
# Without a key the buttons don't appear.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2
